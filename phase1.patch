-          qdly = 20;
+          // NOTE: a second, unguarded "if(Current <= (Last + 1)) NumDown++;" used to
+          // sit here. It had no (TuneStep < quadATmaxStep) guard, so during the fine
+          // sweeps NumDown climbed by 2 per pass and the downward search gave up after
