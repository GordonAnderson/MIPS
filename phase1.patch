       Freq = RFAarray[brd]->Freq = (quadATmaxF + quadATminF)/2;
+      StartFreq = Freq;
       RFAarray[brd]->Enabled = true;
       TuneStep = quadATmaxStep;
       state = QUAD_AT_DWN;
@@ -1887,8 +1940,12 @@ void quadAutoTune(int brd, bool report)
