diff --git a/src/ADCdrv.cpp b/src/ADCdrv.cpp
index a90dbf0..59efa3e 100644
--- a/src/ADCdrv.cpp
+++ b/src/ADCdrv.cpp
@@ -495,10 +495,23 @@ bool ADCacquireWait(void)
 bool ADCfindSum(int *sum)
 {
   if(ADCbuffer == NULL) return false;
-  if(ADCvectorNum <= 0) return false;
+  // Wait BEFORE testing ADCvectorNum, not after. ADCvectorNum is incremented by the
+  // ENDRX ISR when a vector completes, and ADCrbSetup() zeroes it. The QSCAN priming
+  // acquisition triggers and then calls straight in here, so at that instant the
+  // conversion has only just started and ADCvectorNum is still 0: the old ordering
+  // rejected the vector it had itself just triggered, QUADscanAcquire failed, and the
+  // scan aborted before its first point. The host received a well formed header and
+  // abort trailer carrying no data.
+  //
+  // Reordering is safe for the RFAACQ path, which calls this BEFORE its trigger. At
+  // that point the clock is stopped, so ADCacquireWait() returns immediately and the
+  // ADCvectorNum test still rejects the first call of a host driven scan exactly as
+  // before, leaving the caller's preset sum of 0 untouched.
+  //
   // A timeout must report failure. Returning -1 from a bool function yields true,
   // so the caller would sum whatever stale data was left in the buffer.
   if(!ADCacquireWait()) return false;
+  if(ADCvectorNum <= 0) return false;
   *sum = 0;
   for(int i=0;i<ADCnumsamples;i++) *sum += ADCbuffer[i];
   return true;
