+// from that stale reading, nothing later beats it, and the tune converges on the start
+// frequency. 4 seconds; increase if a tune started from a high output state still fails.
+int  quadATstartDelay = 40;
+// Per step delay for the fine passes (TuneStep <= 500). The fine sweeps resolve small
+// level differences, so they get more settling time than the coarse sweep.
+int  quadATfineDelay = 10;
